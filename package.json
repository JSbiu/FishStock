{
  "name": "fish-stock",
  "displayName": "FishStock",
  "description": "轻量、安静、本地优先的 VS Code 自选行情插件",
  "version": "0.4.5",
  "publisher": "fishstock-local",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/JSbiu/FishStock.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "stock",
    "watchlist",
    "A股",
    "港股",
    "期货",
    "大宗商品"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:fishStock.stock",
    "onView:fishStock.futures",
    "onCommand:fishStock.addStock",
    "onCommand:fishStock.addFuture",
    "onCommand:fishStock.refresh",
    "onCommand:fishStock.refreshFutures",
    "onCommand:fishStock.clearWatchlist",
    "onCommand:fishStock.restoreDefaultWatchlist",
    "onCommand:fishStock.restoreDefaultFuturesWatchlist"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fishStock",
          "title": "FishStock",
          "icon": "resources/fishstock.svg"
        }
      ]
    },
    "views": {
      "fishStock": [
        {
          "id": "fishStock.stock",
          "name": "Stock",
          "visibility": "visible",
          "initialSize": 2
        },
        {
          "id": "fishStock.futures",
          "name": "Futures",
          "visibility": "visible",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "fishStock.addStock",
        "title": "FishStock: 添加股票或指数",
        "icon": "$(add)"
      },
      {
        "command": "fishStock.removeStock",
        "title": "FishStock: 删除自选条目",
        "icon": "$(trash)"
      },
      {
        "command": "fishStock.refresh",
        "title": "FishStock: 刷新行情",
        "icon": "$(refresh)"
      },
      {
        "command": "fishStock.addGroup",
        "title": "FishStock: 添加分组",
        "icon": "$(new-folder)"
      },
      {
        "command": "fishStock.renameGroup",
        "title": "FishStock: 重命名分组",
        "icon": "$(edit)"
      },
      {
        "command": "fishStock.removeGroup",
        "title": "FishStock: 删除分组",
        "icon": "$(trash)"
      },
      {
        "command": "fishStock.moveStockUp",
        "title": "FishStock: 自选条目上移",
        "icon": "$(arrow-up)"
      },
      {
        "command": "fishStock.moveStockDown",
        "title": "FishStock: 自选条目下移",
        "icon": "$(arrow-down)"
      },
      {
        "command": "fishStock.moveStockToGroup",
        "title": "FishStock: 移动到其他分组",
        "icon": "$(folder-opened)"
      },
      {
        "command": "fishStock.openWatchlist",
        "title": "FishStock: 打开自选列表"
      },
      {
        "command": "fishStock.openQuote",
        "title": "FishStock: 打开行情页面"
      },
      {
        "command": "fishStock.stockViewMode",
        "title": "FishStock: 股票视图排序与筛选",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "fishStock.futuresViewMode",
        "title": "FishStock: 期货视图排序与筛选",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "fishStock.expandAllStockGroups",
        "title": "FishStock: 展开全部股票分组",
        "icon": "$(expand-all)"
      },
      {
        "command": "fishStock.expandAllFuturesGroups",
        "title": "FishStock: 展开全部期货分组",
        "icon": "$(expand-all)"
      },
      {
        "command": "fishStock.clearWatchlist",
        "title": "FishStock: 清空全部股票自选数据"
      },
      {
        "command": "fishStock.restoreDefaultWatchlist",
        "title": "FishStock: 恢复默认股票自选数据"
      },
      {
        "command": "fishStock.addFuture",
        "title": "FishStock: 添加期货",
        "icon": "$(add)"
      },
      {
        "command": "fishStock.removeFuture",
        "title": "FishStock: 删除期货条目",
        "icon": "$(trash)"
      },
      {
        "command": "fishStock.refreshFutures",
        "title": "FishStock: 刷新期货行情",
        "icon": "$(refresh)"
      },
      {
        "command": "fishStock.addFuturesGroup",
        "title": "FishStock: 添加期货分组",
        "icon": "$(new-folder)"
      },
      {
        "command": "fishStock.renameFuturesGroup",
        "title": "FishStock: 重命名期货分组",
        "icon": "$(edit)"
      },
      {
        "command": "fishStock.removeFuturesGroup",
        "title": "FishStock: 删除期货分组",
        "icon": "$(trash)"
      },
      {
        "command": "fishStock.moveFutureUp",
        "title": "FishStock: 期货条目上移",
        "icon": "$(arrow-up)"
      },
      {
        "command": "fishStock.moveFutureDown",
        "title": "FishStock: 期货条目下移",
        "icon": "$(arrow-down)"
      },
      {
        "command": "fishStock.moveFutureToGroup",
        "title": "FishStock: 移动期货到其他分组",
        "icon": "$(folder-opened)"
      },
      {
        "command": "fishStock.clearFuturesWatchlist",
        "title": "FishStock: 清空全部期货自选"
      },
      {
        "command": "fishStock.restoreDefaultFuturesWatchlist",
        "title": "FishStock: 恢复默认期货自选数据"
      },
      {
        "command": "fishStock.openFutures",
        "title": "FishStock: 打开期货自选"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fishStock.refresh",
          "when": "view == fishStock.stock",
          "group": "navigation@1"
        },
        {
          "command": "fishStock.addStock",
          "when": "view == fishStock.stock",
          "group": "navigation@2"
        },
        {
          "command": "fishStock.addGroup",
          "when": "view == fishStock.stock",
          "group": "2_groups@1"
        },
        {
          "command": "fishStock.stockViewMode",
          "when": "view == fishStock.stock",
          "group": "2_groups@2"
        },
        {
          "command": "fishStock.expandAllStockGroups",
          "when": "view == fishStock.stock",
          "group": "navigation@3"
        },
        {
          "command": "fishStock.clearWatchlist",
          "when": "view == fishStock.stock",
          "group": "9_reset@1"
        },
        {
          "command": "fishStock.restoreDefaultWatchlist",
          "when": "view == fishStock.stock",
          "group": "9_reset@2"
        },
        {
          "command": "fishStock.refreshFutures",
          "when": "view == fishStock.futures",
          "group": "navigation@1"
        },
        {
          "command": "fishStock.addFuture",
          "when": "view == fishStock.futures",
          "group": "navigation@2"
        },
        {
          "command": "fishStock.addFuturesGroup",
          "when": "view == fishStock.futures",
          "group": "2_groups@1"
        },
        {
          "command": "fishStock.futuresViewMode",
          "when": "view == fishStock.futures",
          "group": "2_groups@2"
        },
        {
          "command": "fishStock.expandAllFuturesGroups",
          "when": "view == fishStock.futures",
          "group": "navigation@3"
        },
        {
          "command": "fishStock.clearFuturesWatchlist",
          "when": "view == fishStock.futures",
          "group": "9_reset@1"
        },
        {
          "command": "fishStock.restoreDefaultFuturesWatchlist",
          "when": "view == fishStock.futures",
          "group": "9_reset@2"
        }
      ],
      "view/item/context": [
        {
          "command": "fishStock.addStock",
          "when": "view == fishStock.stock && viewItem == fishStock.group",
          "group": "inline@1"
        },
        {
          "command": "fishStock.addStock",
          "when": "view == fishStock.stock && viewItem == fishStock.group",
          "group": "1_edit@1"
        },
        {
          "command": "fishStock.moveStockUp",
          "when": "view == fishStock.stock && viewItem == fishStock.stock",
          "group": "1_order@1"
        },
        {
          "command": "fishStock.moveStockDown",
          "when": "view == fishStock.stock && viewItem == fishStock.stock",
          "group": "1_order@2"
        },
        {
          "command": "fishStock.moveStockToGroup",
          "when": "view == fishStock.stock && viewItem == fishStock.stock",
          "group": "2_group@1"
        },
        {
          "command": "fishStock.removeStock",
          "when": "view == fishStock.stock && viewItem == fishStock.stock",
          "group": "9_delete@1"
        },
        {
          "command": "fishStock.renameGroup",
          "when": "view == fishStock.stock && viewItem == fishStock.group",
          "group": "1_edit@2"
        },
        {
          "command": "fishStock.removeGroup",
          "when": "view == fishStock.stock && viewItem == fishStock.group",
          "group": "9_delete@1"
        },
        {
          "command": "fishStock.addFuture",
          "when": "view == fishStock.futures && viewItem == fishStock.futuresGroup",
          "group": "inline@1"
        },
        {
          "command": "fishStock.addFuture",
          "when": "view == fishStock.futures && viewItem == fishStock.futuresGroup",
          "group": "1_edit@1"
        },
        {
          "command": "fishStock.moveFutureUp",
          "when": "view == fishStock.futures && viewItem == fishStock.future",
          "group": "1_order@1"
        },
        {
          "command": "fishStock.moveFutureDown",
          "when": "view == fishStock.futures && viewItem == fishStock.future",
          "group": "1_order@2"
        },
        {
          "command": "fishStock.moveFutureToGroup",
          "when": "view == fishStock.futures && viewItem == fishStock.future",
          "group": "2_group@1"
        },
        {
          "command": "fishStock.removeFuture",
          "when": "view == fishStock.futures && viewItem == fishStock.future",
          "group": "9_delete@1"
        },
        {
          "command": "fishStock.renameFuturesGroup",
          "when": "view == fishStock.futures && viewItem == fishStock.futuresGroup",
          "group": "1_edit@2"
        },
        {
          "command": "fishStock.removeFuturesGroup",
          "when": "view == fishStock.futures && viewItem == fishStock.futuresGroup",
          "group": "9_delete@1"
        }
      ]
    },
    "configuration": {
      "title": "FishStock",
      "properties": {
        "fishStock.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "maximum": 3600,
          "description": "自动刷新间隔（秒）。低于 15 秒的值会按 15 秒处理。"
        },
        "fishStock.staleAfterSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 30,
          "maximum": 86400,
          "description": "开市行情超过此时间未更新时标记为数据过期（秒）。"
        },
        "fishStock.statusBar.rotationSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 3,
          "maximum": 60,
          "description": "状态栏轮播间隔（秒）。"
        },
        "fishStock.colorConvention": {
          "type": "string",
          "enum": [
            "china",
            "international"
          ],
          "enumDescriptions": [
            "涨红跌绿",
            "涨绿跌红"
          ],
          "default": "china",
          "description": "自选列表中的涨跌颜色习惯。状态栏不使用醒目背景色。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm run compile && node --test out/test/*.test.js",
    "check": "pnpm run lint && pnpm run test",
    "package:vsix": "pnpm run check && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.17.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^9.31.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0"
  },
  "packageManager": "pnpm@11.9.0"
}
