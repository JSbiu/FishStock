  "displayName": "FishStock",
  "description": "轻量、安静、本地优先的股票、ETF、期货与持仓行情插件",
  "version": "0.7.8",
  "publisher": "jsbiu",
  "private": true,
  "author": {
    "name": "JSbiu",
    "url": "https://github.com/JSbiu"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JSbiu/FishStock.git"
  },
  "homepage": "https://github.com/JSbiu/FishStock#readme",
  "bugs": {
    "url": "https://github.com/JSbiu/FishStock/issues"
  },
  "icon": "resources/fishstock.png",
  "galleryBanner": {
    "color": "#0B1F33",
    "theme": "dark"
  },
  "preview": true,
  "pricing": "Free",
  "engines": {
    "vscode": "^1.90.0"
