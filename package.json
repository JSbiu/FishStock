    "configuration": {
      "title": "FishStock",
      "properties": {
        "fishStock.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "maximum": 3600,
          "description": "自动刷新间隔（秒）。低于 15 秒的值会按 15 秒处理。"
        },
        "fishStock.staleAfterSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 30,
          "maximum": 86400,
          "description": "交易时段内距最近一次成功获取行情超过此时间时标记为刷新超时（秒）。"
        },
        "fishStock.statusBar.rotationSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 3,
          "maximum": 60,
          "description": "状态栏轮播间隔（秒）。"
        },
        "fishStock.colorConvention": {
          "type": "string",
          "enum": [
            "china",
            "international"
          ],
          "enumDescriptions": [
            "涨红跌绿",
            "涨绿跌红"
          ],
          "default": "china",
          "description": "自选列表中的涨跌颜色习惯。状态栏不使用醒目背景色。"
        },
        "fishStock.holdings.treeViewFields": {
          "type": "object",
          "properties": {
            "quantity": {
              "type": "boolean",
              "default": true,
              "description": "数量（持仓 /份数）。"
            },
            "marketValue": {
              "type": "boolean",
              "default": true,
              "description": "市值（按万 / 亿压缩）。"
            },
            "profit": {
              "type": "boolean",
              "default": true,
              "description": "浮动盈亏（金额后括号内为相对成本的收益率）。"
            },
            "dayProfit": {
              "type": "boolean",
              "default": true,
              "description": "当日盈亏（金额后括号内为相对昨昨收的百分比）。"
            }
          },
          "default": {
            "quantity": true,
            "marketValue": true,
            "profit": true,
            "dayProfit": true
          },
          "description": "Holdings Tree View 描述行展示哪些字段。未勾选的字段在悬浮面板与编辑器管理器仍可见；至少保留一个字段，强制保留市值作为兜底。"
        },
        "fishStock.holdings.hkdToCnyRate": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0.1,
          "maximum": 2,
          "description": "港币折算人民币的汇率（如 0.8557）。留空表示不折算，港币持仓按原币种显示；折算只作用于金额，百分比不受影响。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
